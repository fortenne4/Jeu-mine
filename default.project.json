      }
    },

    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Partage": {
        "$path": "src/partage"
      }
    },

    "ReplicatedFirst": {
      "$ignoreUnknownInstances": true,
      "ChargementJeu": {
